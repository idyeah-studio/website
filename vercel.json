{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/assets/idyeah/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/assets/(?!idyeah/fonts/)(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/mosaix/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mosaix.idyeah.studio"
        }
      ],
      "dest": "/mosaix/$1",
      "check": true,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/archived(?:/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/magazine(?:/index(?:\\.html)?)?/?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/proof/?",
      "status": 308,
      "headers": {
        "Location": "/proof/mosaix"
      }
    },
    {
      "src": "/products/?",
      "status": 308,
      "headers": {
        "Location": "/products/keya"
      }
    },
    {
      "src": "/off-idyeah/archive(?:\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/off-idyeah"
      }
    },
    {
      "src": "/inside",
      "dest": "/magazine/inside.html"
    },
    {
      "src": "/magazine/services(?:\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/practice"
      }
    },
    {
      "src": "/practice",
      "dest": "/magazine/services.html"
    },
    {
