{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/assets/idyeah/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/assets/(?!idyeah/fonts/)(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/mosaix/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mosaix.idyeah.studio"
        }
      ],
      "dest": "/mosaix/$1",
      "check": true,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/archived(?:/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/off-idyeah(?:\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/magazine/off-idyeah"
      }
    },
    {
      "src": "/off-idyeah/archive(?:\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/magazine/off-idyeah"
      }
    },
    {
      "src": "/off-idyeah/(00[1-5])(?:\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/magazine/off-$1"
      }
    }
  ]
}
